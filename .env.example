# Copy this file to .env and fill in the values.
# Never commit .env — it is listed in .gitignore.

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL for the Surespot backend (no trailing slash).
# Use the production URL for release builds.
EXPO_PUBLIC_API_URL=https://api.surespot.ng

# ── Third-party API keys ──────────────────────────────────────────────────────
# These are NOT prefixed with EXPO_PUBLIC_ so they are never baked into the JS bundle.
# They are used server-side only; the client must not call these APIs directly.
GOOGLE_PLACES_API_KEY=your_google_places_key_here
LOCATIONIQ_API_KEY=your_locationiq_key_here

# ── Development / testing mock data ──────────────────────────────────────────
# Used only in dev builds (not included in production builds).
MOCK_COUNTRY_CODE=+234
MOCK_PHONE_NUMBER=
MOCK_FULL_PHONE=
MOCK_OTP_CODE=
MOCK_PASSWORD=
MOCK_EMAIL=
MOCK_GOOGLE_NAME=
MOCK_FIRST_NAME=
MOCK_LAST_NAME=
MOCK_BIRTHDAY=
